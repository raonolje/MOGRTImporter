<?xml version="1.0" encoding="UTF-8"?>
<ExtensionManifest Version="11.0"
    ExtensionBundleId="com.manus.mogrtimporter"
    ExtensionBundleVersion="1.1.6"
    ExtensionBundleName="MOGRT Subtitle Importer"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <ExtensionList>
        <Extension Id="com.manus.mogrtimporter.panel" Version="1.1.6"/>
    </ExtensionList>
    <ExecutionEnvironment>
        <HostList>
            <Host Name="PPRO" Version="[14.0,99.9]"/>
        </HostList>
        <LocaleList>
            <Locale Code="All"/>
        </LocaleList>
        <RequiredRuntimeList>
            <RequiredRuntime Name="CSXS" Version="11.0"/>
        </RequiredRuntimeList>
    </ExecutionEnvironment>
    <DispatchInfoList>
        <Extension Id="com.manus.mogrtimporter.panel">
            <DispatchInfo>
                <Resources>
                    <MainPath>./html/index.html</MainPath>
                    <ScriptPath>./jsx/hostscript.jsx</ScriptPath>
                    <CEFCommandLine>
                        <Parameter>--enable-nodejs</Parameter>
                        <Parameter>--mixed-context</Parameter>
                        <Parameter>--disable-popup-blocking</Parameter>
                    </CEFCommandLine>
                </Resources>
                <Lifecycle>
                    <AutoVisible>true</AutoVisible>
                </Lifecycle>
                <UI>
                    <Type>Panel</Type>
                    <Menu>MOGRT Subtitle Importer</Menu>
                    <Geometry>
                        <Size>
                            <Height>700</Height>
                            <Width>520</Width>
                        </Size>
                        <MinSize>
                            <Height>500</Height>
                            <Width>400</Width>
                        </MinSize>
                    </Geometry>
                </UI>
            </DispatchInfo>
        </Extension>
    </DispatchInfoList>
</ExtensionManifest>
